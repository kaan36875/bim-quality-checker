<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2027.3.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2027.3.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\BIMQualityChecker.Core.csproj" />
    <ProjectReference Include="..\Reporting\BIMQualityChecker.Reporting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\rules\default-rules.json" Link="rules\default-rules.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="BIMQualityChecker.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyToRevitAddins" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <PropertyGroup>
      <RevitAddinsFolder>$(AppData)\Autodesk\Revit\Addins\2027</RevitAddinsFolder>
      <PluginFolder>$(RevitAddinsFolder)\BIMQualityChecker</PluginFolder>
    </PropertyGroup>
    <MakeDir Directories="$(PluginFolder)\rules" />
    <Copy SourceFiles="$(TargetDir)$(TargetFileName)" DestinationFolder="$(PluginFolder)" />
    <Copy SourceFiles="$(TargetDir)BIMQualityChecker.Core.dll" DestinationFolder="$(PluginFolder)" />
    <Copy SourceFiles="$(TargetDir)BIMQualityChecker.Reporting.dll" DestinationFolder="$(PluginFolder)" />
    <Copy SourceFiles="$(TargetDir)Newtonsoft.Json.dll" DestinationFolder="$(PluginFolder)" />
    <Copy SourceFiles="$(TargetDir)rules\default-rules.json" DestinationFolder="$(PluginFolder)\rules" />
    <Copy SourceFiles="$(TargetDir)BIMQualityChecker.addin" DestinationFolder="$(RevitAddinsFolder)" />
  </Target>

</Project>
